{
  "mcpServers": {
    "lua-platform": {
      "command": "node",
      "args": ["./mcp/lua-platform/dist/server.js"],
      "env": {
        "LUA_API_KEY": "${env:LUA_API_KEY}"
      }
    },
    "lua-docs": {
      "type": "http",
      "url": "https://docs.heylua.ai/mcp"
    },
    "ui": {
      "type": "http",
      "url": "https://ui.lua.dev/mcp"
    }
  }
}
